{
  "pretraining_method": "simclr",
  "pretraining": {
    "skip_if_checkpoint_exists": true,
    "checkpoint_path": "pretrained_feature_extractors",
    "save_checkpoint": true,
    "num_epochs": 50,
    "learning_rate": 1e-4,
    "weight_decay": 1e-5,
    "feature_extractor": {
      "name": "resnet18",
      "freeze": true,
      "freeze_first_n_blocks": 2,
      "unfreeze_after_n_epochs": 10000
    }
  },
  "hyperparameter_tuning": {
    "pretraining": {
      "num_epochs": [100, 200],
      "learning_rate": [1e-5, 5e-5, 1e-4],
      "weight_decay": [1e-5, 1e-4]
    }
  }
}
