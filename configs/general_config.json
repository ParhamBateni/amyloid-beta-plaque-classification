{
    "data": {
        "data_folder": "data",
        "data_table_file_name": "data_table_sampled_10k.csv",
        "labeled_data_folder": "labeled_images",
        "unlabeled_data_folder": "sampled_unlabeled_images",
        "runs_folder": "runs",
        "downscaled_image_size": [
            224,
            224
        ],
        "downscaling_method": "bilinear",
        "unlabeled_sample_size": 10000,
        "labeled_sample_size": 1e9,
        "preload": false,
        "apply_transforms_on_the_fly": false,
        "normalize_data": true,
        "normalize_mean": [
            0.485,
            0.456,
            0.406
        ],
        "normalize_std": [
            0.229,
            0.224,
            0.225
        ],
        "use_extra_features": false,
        "extra_feature_dim": 2,
        "number_of_augmentations": 3,
        "exclude_raw_images": false
    },
    "architecture": {
        "feature_extractor": {
            "name": "resnet18",
            "freeze": true,
            "freeze_first_n_blocks": 10000,
            "unfreeze_after_n_epochs": 20,
            "unfreeze_last_n_blocks": 1
        },
        "classifier": {
            "name": "linear"
        }
    },
    "training": {
        "test_size": 0.2,
        "val_size": 0.1,
        "num_workers": 4,
        "pin_memory": true,
        "persistent_workers": true,
        "batch_size": 32,
        "num_epochs": 200,
        "optimizer": "adamw",
        "learning_rate": 1e-5,
        "weight_decay": 1e-5,
        "early_stop": 2,
        "early_stop_check_val_every_n_epoch": 5,
        "checkpoint_monitor": "val_f1",
        "use_thresholding": false,
        "threshold_min": 0,
        "threshold_max": 1,
        "threshold_steps": 5,
        "hyperparemeter_tuning_val_size": 0.2
    },
    "system": {
        "debug_mode": false,
        "log_mode": true,
        "random_seed": 44,
        "seed_everything": true,
        "tensorboard_log": false
    },
    "hyperparameter_tuning": {
        "architecture": {
            "feature_extractor_name": [
                "resnet18"
            ],
            "classifier_name": [
                "linear"
            ]
        },
        "training": {
            "learning_rate": [
                1e-05,
                5e-05,
                1e-04
            ],
            "batch_size": [
                64,
                128
            ],
            "weight_decay": [
                1e-05,
                1e-04
            ]
        }
    }
}